# Copy to deploy/public.env on the server and fill in. Never commit the filled-in file.
SITE_ADDRESS=demo.example.com
# Empty with a domain. For an IP-only link: TLS_DIRECTIVE=tls internal
TLS_DIRECTIVE=

POSTGRES_DB=realitycheck
POSTGRES_USER=realitycheck
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Restore the demonstration every night at 21:30 UTC (03:00 in India).
REALITYCHECK_DEMO_RESET_CRON=0 30 21 * * *

# The analyst: Claude with a $2 cap per UTC day (owner decision, 19 Nov). Set AI_PROVIDER=template for none.
AI_PROVIDER=anthropic
AI_API_KEY=paste-the-key-here-on-the-server-only
AI_MODEL=claude-haiku-5-5
AI_DAILY_BUDGET_USD=2
AI_REQUESTS_PER_MINUTE=10
