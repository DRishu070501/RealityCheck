# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- Database -------------------------------------------------------------
POSTGRES_DB=realitycheck
POSTGRES_USER=realitycheck
# Local-development placeholder. Use a strong value anywhere other than your own machine.
POSTGRES_PASSWORD=realitycheck

# --- Host ports (change if something else already uses them) ---------------
# Not 5432, so a locally installed PostgreSQL does not clash.
DB_HOST_PORT=15432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# --- Backend ---------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated). Include the Docker frontend's own
# origin as well as the Vite dev server: browsers send Origin on every POST, PUT, PATCH and DELETE,
# even to the same origin through the proxy, and a missing entry makes every write fail with 403.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Serve /swagger-ui.html and /v3/api-docs.
API_DOCS_ENABLED=true

# --- Demonstration data ----------------------------------------------------
# Create the fictional factory "Surat Diamond Works" at start-up when the database has no factory.
REALITYCHECK_DEMO_SEED=true
# Allow Settings > Reset demo data (POST /api/demo/reset). It ERASES ALL DATA and re-seeds.
# Set both to false for any deployment that holds data you want to keep.
REALITYCHECK_DEMO_RESET_ENABLED=true

# --- AI analyst (optional; the application works without it) ---------------
# template  = the built-in analyst: fixed rules over the simulation evidence, no network, no cost.
# anthropic = Claude. Used only when AI_API_KEY is also set; otherwise the template answers.
# The key is read by the backend only. Never commit it and never put it in frontend code.
AI_PROVIDER=template
AI_API_KEY=
# Claude Haiku 5.5 is the low-cost default (USD 0.10 / 0.50 per million input / output tokens).
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_SECONDS=30
# Transport retries on timeouts, 429 and 5xx, with backoff.
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4000
# AI requests accepted per minute across all users; more get HTTP 429. Bounds what the model can cost.
AI_REQUESTS_PER_MINUTE=20
